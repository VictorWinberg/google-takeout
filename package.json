{
  "name": "google-takeout",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node server/index.js\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "geo-tz": "^8.1.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
